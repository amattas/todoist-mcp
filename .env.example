# ============================================================================
# Todoist MCP Server Configuration
# ============================================================================

# Todoist Configuration (Required)
TODOIST_API_TOKEN=your-todoist-api-token-here

# Timezone Configuration (Optional)
# IANA timezone name (default: US/Eastern)
TIMEZONE=US/Eastern

# Optional: Enable debug logging
DEBUG=false

# ============================================================================
# Remote Server Configuration (for HTTP mode)
# ============================================================================

# API Key for authentication (strongly recommended for HTTP mode)
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=your-secure-api-key-here

# Server binding
HOST=0.0.0.0
PORT=8080

# ============================================================================
# Redis Cache Configuration (Optional - improves performance)
# ============================================================================

# Redis connection details
# REDIS_HOST=your-redis-host.redis.cache.windows.net
# REDIS_SSL_PORT=6380
# REDIS_KEY=your-redis-access-key

# Cache TTL Configuration (Optional - all values in seconds)
# Customize cache times based on your needs. Lower values = more fresh data but more API calls

# Todoist Cache Times
# CACHE_TTL_TODOIST_TASKS=60         # Task list cache (default: 60s)
# CACHE_TTL_TODOIST_PROJECTS=300     # Project list cache (default: 300s / 5 min)
# CACHE_TTL_TODOIST_LABELS=600       # Label list cache (default: 600s / 10 min)
# CACHE_TTL_TODOIST_SECTIONS=300     # Section list cache (default: 300s / 5 min)
# CACHE_TTL_TODOIST_COMMENTS=120     # Comments cache (default: 120s / 2 min)
